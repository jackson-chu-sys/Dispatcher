# ===== Dispatcher 试用版配置 =====
# 改完保存，然后重启服务（Windows 双击 stop.bat 再 start.bat；Mac/Linux：bash stop.sh && bash start.sh）

# 演示模式：1=登录页显示演示账号一键登录（仅本地试用）；0=关闭（正式上线务必改 0）
DEMO_MODE=1

# 调度员登录口令：留空则首次启动自动生成，查看 data/.dispatcher_pass 文件
DISPATCHER_PASSWORD=

# ----- 高德地图（可选，不填则用自绘示意图，功能照常）-----
# 免费申请：https://console.amap.com → 应用管理 → 创建应用 → 添加 Key（服务平台选「Web端(JS API)」）
# 把下面两行等号后替换成你申请到的值（不要加引号和空格）：
#   AMAP_JS_KEY = Web端(JS API) 的 Key
#   AMAP_SECURITY_CODE = 该 Key 配套的安全密钥(jscode)
AMAP_JS_KEY=
AMAP_SECURITY_CODE=
# Web服务 key（逆地理编码等后端用途，预留，可不填）
AMAP_WEB_KEY=

# ----- 企业微信群机器人通知（可选，不填则不推送）-----
# 也可在系统「台账 → 通知设置」页填写，二选一即可
WECOM_WEBHOOK_URL=
NOTIFY_ENABLED=1
# 叫车超时未接单告警（秒）/ 发车晚点告警（分钟）/ 上报断流告警（分钟）
RIDE_TIMEOUT_SEC=180
LATE_MIN=5
STALE_MIN=30
