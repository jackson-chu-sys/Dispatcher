# Dispatcher 环境变量示例 — 复制为 .env（gitignored）后填写

# 高德地图（复用 Where2Go 的 key；JS 与 Web 服务两把 key 平台隔离，混用报 USERKEY_PLAT_NOMATCH）
AMAP_JS_KEY=       # Web端(JS API) key，前端地图
AMAP_SECURITY_CODE=# JS key 配套安全密钥，缺失报 INVALID_USER_SCODE
AMAP_WEB_KEY=      # Web服务 key（逆地理编码等后端用途，预留）

# 调度员登录口令；留空则首启随机生成，见 data/.dispatcher_pass（0600）
DISPATCHER_PASSWORD=

# 通知（企业微信群机器人 webhook，多个用逗号分隔；也可在台账页「通知设置」配置，
#       config 表优先于环境变量；留空则通知待命不发）
WECOM_WEBHOOK_URL=
NOTIFY_ENABLED=1
# 叫车超时未接单告警阈值（秒） / 发车晚点告警阈值（分钟）
RIDE_TIMEOUT_SEC=180
LATE_MIN=5
